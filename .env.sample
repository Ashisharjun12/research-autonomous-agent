PORT=3000
POSTGRES_DATABASE_URL=

# Agentic AI — UniversalGateway → any OpenAI-compatible API (OpenRouter, LiteLLM, vLLM, etc.)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
# Provider model id only — do NOT add universal/main/ prefix (model.ts adds it automatically)
# Do NOT set OPENAI_API_KEY, MINIMAX_API_KEY, etc. — only LLM_API_KEY
LLM_MODEL=openai/gpt-4o-mini
# Tool agents + orchestrator — must support function/tool calling on your provider
LLM_TOOL_MODEL=openai/gpt-4o-mini

# Optional OpenRouter headers (recommended by OpenRouter)
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=research-agent

# Storage
AI_DATABASE_URL=

# Web search (Tavily)
TRAVILY_WEB_SEARCH_API_KEY=

# Page fetch (Scrape.do token)
SCRAPER_API_KEY=

# Observability
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=research-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_TRACING=

# Guardrails (optional — falls back to LLM_MODEL)
GUARDRAIL_MODEL=
